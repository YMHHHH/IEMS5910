# 服务器配置
SERVER_URL=http://192.168.3.143:3001
DEVICE_ID=elder-device-01

# 处理器选择：'native' 或 'rknn'
WHISPER_TYPE=rknn

# RKNN配置
ENCODER_MODEL_PATH=./model/whisper_encoder_base_20s.rknn
DECODER_MODEL_PATH=./model/whisper_decoder_base_20s.rknn
VOCAB_PATH=./model/vocab_en.txt
TASK=en
RKNN_TARGET=rk3566
RKNN_DEVICE_ID=

# native配置
WHISPER_MODEL=base
WHISPER_TASK=en

# 音频模式
MOCK_AUDIO=false

# 麦克风参数
SILENCE_THRESHOLD=300
MIN_AUDIO_DURATION=0.5
MAX_AUDIO_DURATION=20

# 事件间隔
MIN_INTERVAL=3
MAX_INTERVAL=8

# 音频设备
AUDIO_DEVICE_INDEX=2
